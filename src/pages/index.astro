---
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#031d33" />
  <title>Pirate Deck · Tula’s Island</title>
  <style is:global>
    :root{font-family:Inter,-apple-system,BlinkMacSystemFont,"SF Pro Rounded",system-ui,sans-serif;color:#fff5d7;background:#021522}*{box-sizing:border-box}html,body{margin:0;min-width:320px;min-height:100%;background:#021522}button{font:inherit;-webkit-tap-highlight-color:transparent}.app{min-height:100svh;max-width:520px;margin:auto;position:relative;overflow:hidden;padding:max(12px,env(safe-area-inset-top)) 12px calc(18px + env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(0,20,35,.15),rgba(0,14,27,.92)),url('https://o-some.github.io/tulasisland/assets/creative/world_harbor.webp') center/cover fixed;color:#fff4ce}.app:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 75% 17%,rgba(255,214,111,.18),transparent 20%),linear-gradient(180deg,rgba(3,24,42,.15),rgba(1,13,24,.88));pointer-events:none}.hud,.battle,.hand,.log,.learn{position:relative;z-index:2}.hud{display:grid;grid-template-columns:46px 1fr auto;gap:8px;align-items:center}.circle,.chip{border:1px solid rgba(242,200,94,.66);background:rgba(2,31,52,.78);box-shadow:inset 0 1px rgba(255,255,255,.08),0 7px 18px rgba(0,8,18,.28);backdrop-filter:blur(14px)}.circle{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;color:#ffe08a}.brand{min-width:0}.brand small{display:block;color:#bddfe2;font-size:.55rem;font-weight:900;letter-spacing:.13em}.brand b{display:block;font:900 1.2rem/1 Georgia,serif;color:#fff0b8;letter-spacing:.02em}.chip{border-radius:999px;padding:7px 10px;display:flex;gap:8px;align-items:center;font-weight:900}.chip span{color:#f2c85e}.bossbar{margin:12px 0 8px;padding:8px 10px;border:1px solid rgba(239,199,102,.7);border-radius:17px;background:rgba(49,31,17,.68);box-shadow:0 10px 24px rgba(0,7,16,.28)}.bossbar-top,.playerbar{display:flex;justify-content:space-between;align-items:center;gap:8px}.bossbar small,.playerbar small{color:#eac96e;font-weight:950;letter-spacing:.1em;font-size:.54rem}.bossbar strong{font:900 .95rem/1 Georgia,serif}.health{height:10px;border-radius:999px;background:rgba(255,255,255,.12);overflow:hidden;margin-top:7px}.health i{display:block;height:100%;width:100%;background:linear-gradient(90deg,#ce443e,#ff7768);transition:width .25s}.battle{min-height:390px;border:1px solid rgba(239,199,102,.55);border-radius:30px;padding:14px 12px 12px;background:linear-gradient(160deg,rgba(4,51,78,.90),rgba(1,24,43,.94));box-shadow:inset 0 1px rgba(255,255,255,.08),0 24px 50px rgba(0,7,16,.42)}.bosszone{display:grid;grid-template-columns:125px 1fr;gap:8px;align-items:center;min-height:178px}.boss-img{width:132px;height:175px;object-fit:contain;filter:drop-shadow(0 18px 14px rgba(0,0,0,.48))}.taunt{padding:10px 11px;border:1px solid rgba(244,205,103,.56);border-radius:17px 17px 17px 5px;background:rgba(2,32,54,.88);font-size:.73rem;line-height:1.35;color:#fff2c7}.lanes{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:5px 0 10px}.slot{min-height:74px;border:1px dashed rgba(201,230,231,.28);border-radius:17px;background:rgba(1,27,47,.45);display:grid;place-items:center;color:#7fa8ad;font-size:.58rem}.slot.unit{border-style:solid;border-color:rgba(239,199,102,.56);background:linear-gradient(180deg,rgba(15,77,92,.72),rgba(3,39,61,.88));color:#fff3cb;text-align:center;padding:6px}.slot.unit b{display:block;font-size:.71rem}.slot.unit span{display:block;margin-top:4px;color:#ffe08a;font-weight:900}.playerbar{padding:7px 2px 3px}.energy{display:flex;gap:3px}.orb{width:12px;height:12px;border-radius:50%;border:1px solid #8be8e3;background:#1fb9b8;box-shadow:0 0 8px rgba(39,214,208,.4)}.orb.off{background:rgba(255,255,255,.09);border-color:rgba(255,255,255,.15);box-shadow:none}.hand{margin-top:10px}.hand-title{display:flex;justify-content:space-between;align-items:center;margin:0 2px 7px}.hand-title small{font-size:.53rem;font-weight:950;letter-spacing:.12em;color:#e9ca70}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.card{position:relative;min-width:0;min-height:142px;padding:8px 6px 7px;border:1px solid #f3d174;border-bottom:5px solid #6e4312;border-radius:16px;background:linear-gradient(180deg,#fff0a8 0%,#e0ad43 48%,#7a4819 49%,#143d56 52%,#08243b 100%);color:#09263a;box-shadow:inset 0 1px rgba(255,255,255,.72),0 7px 15px rgba(0,9,18,.34);text-align:left;cursor:pointer;transition:transform .13s}.card:active{transform:translateY(3px)}.cost{position:absolute;top:-7px;left:-5px;width:27px;height:27px;border-radius:50%;display:grid;place-items:center;background:#178e9d;color:white;border:2px solid #a8f1e8;font-weight:1000;font-size:.72rem}.card .art{height:52px;display:grid;place-items:center;font-size:2rem}.card strong{display:block;color:#09263a;font:900 .7rem/1 Georgia,serif;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card p{margin:8px 0 0;color:#e6f0ed;font-size:.51rem;line-height:1.25;text-align:center}.card .stats{position:absolute;left:7px;right:7px;bottom:5px;display:flex;justify-content:space-between;color:#fff0b8;font-size:.56rem;font-weight:950}.card.disabled{filter:grayscale(.75);opacity:.46}.footer-actions{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:9px}.end{min-height:48px;border:1px solid #ffe79d;border-radius:16px;background:linear-gradient(180deg,#ffe28b,#d7a032);color:#092c43;font-weight:1000;box-shadow:0 5px 0 #754510}.mini{min-width:72px;border:1px solid rgba(239,199,102,.5);border-radius:16px;background:rgba(2,31,52,.83);color:#fff0b8;font-weight:900}.log{min-height:22px;margin:7px 4px 0;color:#c9e6e7;font-size:.62rem;text-align:center}.learn{position:fixed;z-index:50;inset:0;display:none;place-items:end center;padding:18px 12px calc(12px + env(safe-area-inset-bottom));background:rgba(0,9,18,.72);backdrop-filter:blur(10px)}.learn.open{display:grid}.sheet{width:min(100%,496px);padding:18px;border:1px solid rgba(239,199,102,.75);border-radius:28px;background:linear-gradient(160deg,#073d5c,#021d34);box-shadow:0 25px 70px rgba(0,0,0,.5)}.sheet small{color:#efc766;font-weight:950;letter-spacing:.13em}.sheet h2{margin:7px 0 5px;font:900 1.55rem/1.05 Georgia,serif;color:#fff0bd}.sheet p{margin:0 0 13px;color:#c9e6e7;font-size:.8rem;line-height:1.4}.answers{display:grid;gap:8px}.answer{min-height:50px;border:1px solid rgba(239,199,102,.48);border-radius:16px;background:rgba(2,30,50,.82);color:#fff3cf;font-weight:900}.answer.good{background:#176c5b}.answer.bad{background:#78363b}.mastery{margin-top:12px;padding:9px 10px;border-radius:14px;background:rgba(255,255,255,.05);color:#dfeeed;font-size:.67rem;line-height:1.35}.overlay{position:fixed;z-index:80;inset:0;display:grid;place-items:center;padding:20px;background:linear-gradient(180deg,rgba(1,14,25,.45),rgba(1,12,22,.94)),url('https://o-some.github.io/tulasisland/assets/creative/world_harbor.webp') center/cover}.overlay.hidden{display:none}.intro{width:min(100%,420px);text-align:center;padding:24px 18px;border:1px solid rgba(239,199,102,.72);border-radius:30px;background:rgba(2,30,50,.88);backdrop-filter:blur(15px);box-shadow:0 30px 70px rgba(0,0,0,.46)}.intro .skull{font-size:3rem}.intro h1{margin:5px 0 6px;font:900 2.2rem/1 Georgia,serif;color:#fff0bd}.intro p{color:#c9e6e7;line-height:1.5;font-size:.82rem}.intro button{width:100%;min-height:58px;border:1px solid #fff0a8;border-radius:18px;background:linear-gradient(180deg,#ffe18a,#dca43a);color:#082f4b;font-weight:1000;box-shadow:0 6px 0 #74420d}.intro .note{display:block;margin-top:12px;color:#9fc9cd;font-size:.6rem}@media(max-width:380px){.cards{gap:5px}.card{min-height:132px;padding-left:4px;padding-right:4px}.card p{font-size:.47rem}.bosszone{grid-template-columns:112px 1fr}.boss-img{width:118px}.battle{padding-left:9px;padding-right:9px}}
  </style>
</head>
<body>
<div class="app" id="app">
  <header class="hud">
    <button class="circle" aria-label="Zurück">‹</button>
    <div class="brand"><small>TULA’S ISLAND</small><b>PIRATE DECK</b></div>
    <div class="chip"><span>🐚</span><b id="shells">0</b></div>
  </header>
  <section class="bossbar">
    <div class="bossbar-top"><div><small>LEVEL 1 · BOSS</small><strong>Pirat Kai</strong></div><b id="bossHpText">18 / 18</b></div>
    <div class="health"><i id="bossHp"></i></div>
  </section>
  <main class="battle">
    <div class="bosszone">
      <img class="boss-img" src={`${base}pirat-kai.svg`} alt="Pirat Kai" />
      <div class="taunt" id="taunt">„Na los, Inselkröte! Zeig mir, ob deine Wörter stärker sind als mein Deck.“</div>
    </div>
    <div class="lanes" id="enemyLanes"><div class="slot">PIRATENPLATZ</div><div class="slot">PIRATENPLATZ</div><div class="slot">PIRATENPLATZ</div></div>
    <div class="lanes" id="playerLanes"><div class="slot">DEIN PLATZ</div><div class="slot">DEIN PLATZ</div><div class="slot">DEIN PLATZ</div></div>
    <div class="playerbar"><div><small>TULA · ❤️ <span id="playerHp">20</span></small></div><div class="energy" id="energy"></div></div>
  </main>
  <section class="hand">
    <div class="hand-title"><small>DEINE HAND</small><small>TIPPE EINE KARTE</small></div>
    <div class="cards" id="cards"></div>
    <div class="footer-actions"><button class="end" id="endTurn">Zug beenden</button><button class="mini" id="restart">↻</button></div>
  </section>
  <div class="log" id="log">Spiele eine Karte und löse die Sprachaufgabe.</div>
</div>
<div class="learn" id="learn"><div class="sheet"><small>KARTEN-MEISTERSCHAFT</small><h2 id="questionTitle">Was bedeutet …?</h2><p id="questionCopy"></p><div class="answers" id="answers"></div><div class="mastery" id="mastery">Richtig = voller Karteneffekt. Falsch = Karte wird schwächer gespielt.</div></div></div>
<div class="overlay" id="intro"><div class="intro"><div class="skull">☠️</div><small>TULA’S ISLAND PRÄSENTIERT</small><h1>Pirate Deck</h1><p>Besiege Pirat Kai mit deinem Sprachdeck. Jede Karte wird stärker, wenn du die Übersetzung richtig kennst.</p><button id="start">⚔️ DUELL STARTEN</button><span class="note">Mobile-first Prototyp · DE → EN</span></div></div>
<script is:inline>
const CARD_POOL=[
{id:'turtle',name:'Schildkröte',en:'turtle',wrong:['island','shell'],emoji:'🐢',cost:2,atk:3,hp:3,text:'Begleiter · Meisterschaft: +2 Angriff'},
{id:'apple',name:'Apfel',en:'apple',wrong:['bread','water'],emoji:'🍎',cost:1,atk:1,hp:2,text:'Begleiter · Meisterschaft: Tula heilt 2'},
{id:'swim',name:'schwimmen',en:'swim',wrong:['sleep','speak'],emoji:'🌊',cost:2,atk:4,hp:1,text:'Aktion · Meisterschaft: sofortiger Angriff'},
{id:'friend',name:'Freund',en:'friend',wrong:['teacher','brother'],emoji:'🤝',cost:2,atk:2,hp:4,text:'Begleiter · Meisterschaft: +2 Leben'},
{id:'sunny',name:'sonnig',en:'sunny',wrong:['cloudy','angry'],emoji:'☀️',cost:1,atk:2,hp:1,text:'Zauber · Meisterschaft: +1 Muschel'},
{id:'book',name:'Buch',en:'book',wrong:['table','ticket'],emoji:'📘',cost:1,atk:1,hp:2,text:'Relikt · Meisterschaft: ziehe Kraft'},
{id:'run',name:'laufen',en:'run',wrong:['dance','answer'],emoji:'🏃',cost:2,atk:3,hp:2,text:'Aktion · Meisterschaft: +2 Schaden'},
{id:'island',name:'Insel',en:'island',wrong:['airport','forest'],emoji:'🏝️',cost:3,atk:4,hp:4,text:'Ort · Meisterschaft: Schutz für Tula'}
];
let state;const $=s=>document.querySelector(s);function reset(){state={bossHp:18,playerHp:20,maxEnergy:3,energy:3,shells:0,hand:shuffle([...CARD_POOL]).slice(0,4),board:[],turn:1,locked:false};render();log('Spiele eine Karte und löse die Sprachaufgabe.')}function shuffle(a){return a.sort(()=>Math.random()-.5)}function log(t){$('#log').textContent=t}function render(){const pct=Math.max(0,state.bossHp/18*100);$('#bossHp').style.width=pct+'%';$('#bossHpText').textContent=`${Math.max(0,state.bossHp)} / 18`;$('#playerHp').textContent=Math.max(0,state.playerHp);$('#shells').textContent=state.shells;$('#energy').innerHTML=Array.from({length:6},(_,i)=>`<i class="orb ${i<state.energy?'':'off'}"></i>`).join('');$('#cards').innerHTML=state.hand.map((c,i)=>`<button class="card ${c.cost>state.energy||state.locked?'disabled':''}" data-i="${i}" ${c.cost>state.energy||state.locked?'disabled':''}><span class="cost">${c.cost}</span><div class="art">${c.emoji}</div><strong>${c.name}</strong><p>${c.text}</p><div class="stats"><span>⚔ ${c.atk}</span><span>❤ ${c.hp}</span></div></button>`).join('');$('#playerLanes').innerHTML=[0,1,2].map(i=>state.board[i]?`<div class="slot unit"><div>${state.board[i].emoji}<b>${state.board[i].name}</b><span>⚔ ${state.board[i].atk} · ❤ ${state.board[i].hp}</span></div></div>`:'<div class="slot">DEIN PLATZ</div>').join('');document.querySelectorAll('.card').forEach(b=>b.onclick=()=>openQuestion(+b.dataset.i));if(state.bossHp<=0)finish(true);if(state.playerHp<=0)finish(false)}function openQuestion(i){const c=state.hand[i];if(!c||c.cost>state.energy)return;state.locked=true;const options=shuffle([c.en,...c.wrong]);$('#questionTitle').textContent=`Was bedeutet „${c.name}“ auf Englisch?`;$('#questionCopy').textContent=`${c.emoji} Kosten: ${c.cost} Wellenenergie`;$('#answers').innerHTML=options.map(o=>`<button class="answer" data-a="${o}">${o}</button>`).join('');$('#learn').classList.add('open');document.querySelectorAll('.answer').forEach(b=>b.onclick=()=>resolveCard(i,b.dataset.a===c.en,b));}function resolveCard(i,correct,btn){const c=state.hand[i];document.querySelectorAll('.answer').forEach(b=>b.disabled=true);btn.classList.add(correct?'good':'bad');if(!correct){[...document.querySelectorAll('.answer')].find(b=>b.dataset.a===c.en)?.classList.add('good')}setTimeout(()=>{state.energy-=c.cost;let played={...c};if(correct){played.atk+=2;state.shells+=c.id==='sunny'?1:0;if(c.id==='apple')state.playerHp=Math.min(20,state.playerHp+2);if(c.id==='friend')played.hp+=2;let dmg=(c.id==='swim'||c.id==='run')?played.atk:1;state.bossHp-=dmg;log(`Perfekt! ${c.name} aktiviert Meisterschaft · ${dmg} Schaden.`)}else{played.atk=Math.max(1,played.atk-1);state.playerHp-=2;log(`Fast! Richtig ist „${c.en}“. Kai kontert für 2 Schaden.`)}if(state.board.length<3)state.board.push(played);state.hand.splice(i,1);const next=CARD_POOL.find(x=>!state.hand.some(h=>h.id===x.id)&&!state.board.some(h=>h.id===x.id));if(next)state.hand.push(next);state.locked=false;$('#learn').classList.remove('open');render()},650)}function enemyTurn(){if(state.locked)return;state.locked=true;$('#taunt').textContent='„Meine Kanonen kennen keine Grammatikfehler!“';setTimeout(()=>{let dmg=2+Math.floor(Math.random()*3);state.playerHp-=dmg;state.maxEnergy=Math.min(6,state.maxEnergy+1);state.energy=state.maxEnergy;state.turn++;state.board=state.board.map(u=>({...u,hp:u.hp-1})).filter(u=>u.hp>0);state.locked=false;$('#taunt').textContent='„Na los, Inselkröte! Zeig mir, ob deine Wörter stärker sind als mein Deck.“';log(`Kai greift an: ${dmg} Schaden. Runde ${state.turn} beginnt.`);render()},650)}function finish(win){state.locked=true;$('#taunt').textContent=win?'„Was?! Mein Deck wurde versenkt!“':'„Harhar! Übe deine Wörter und komm wieder!“';$('#log').textContent=win?'🏆 Pirat Kai besiegt! +10 Muscheln':'💥 Tula wurde besiegt. Starte das Duell neu.';if(win&&state.shells<10)state.shells+=10;document.querySelectorAll('.card').forEach(b=>b.disabled=true)}$('#endTurn').onclick=enemyTurn;$('#restart').onclick=reset;$('#start').onclick=()=>{$('#intro').classList.add('hidden');reset()};reset();
</script>
</body></html>
