---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const assetRoot = 'https://raw.githubusercontent.com/o-some/tulasisland/main';
const kai = `${base}bosses/level-01-pirat-kai.webp`;
const tula = `${assetRoot}/assets/creative/tula_neutral_front.webp`;
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#031b30" />
  <title>Pirate Deck · Tula’s Island</title>
  <link rel="stylesheet" href={`${base}pirate-deck-foundation-v17.css`} />
  <link rel="stylesheet" href={`${base}pirate-deck-runtime-v15.css`} />
</head>
<body>
  <div class="app" id="app">
    <header class="game-header">
      <button class="round-action" aria-label="Zurück">‹</button>
      <div class="title-plaque" aria-label="Pirate Deck – Tula's Island">
        <span class="wheel">☸</span>
        <strong>PIRATE DECK</strong>
        <small>TULA’S ISLAND</small>
      </div>
      <button class="round-action" id="restart" aria-label="Neu starten">↻</button>
    </header>

    <section class="battle-hud" aria-label="Spielstatus">
      <div class="hud-stat hud-shells"><small>MUSCHELN</small><b>🐚 <span id="shells">0</span></b></div>
      <div class="hud-stat"><small>WELLENKRAFT</small><b id="energyText">3 / 3</b></div>
      <div class="turn-medallion"><small>ZUG</small><b id="turnNo">1</b></div>
      <div class="hud-stat hud-health"><small>TULA ❤️</small><b><span id="playerHp">20</span> / 20</b><div class="health player"><i id="playerHpBar"></i></div></div>
      <div class="hud-stat hud-health"><small id="bossHudLabel">PIRAT KAI ❤️</small><b id="bossHpText">24 / 24</b><div class="health"><i id="bossHp"></i></div></div>
    </section>

    <main class="battle-board battle-board-v3">
      <section class="boss-info-strip" aria-label="Bossinformation">
        <span class="boss-ribbon">☠ BOSSFIGHT</span>
        <h1 id="bossTitle">PIRAT KAI</h1>
        <p id="taunt">„Na los, Inselkröte! <b>Zeig mir deine Wortkraft.</b>“</p>
        <div class="boss-progress">
          <span id="bossProgressText">☠ BOSS 1 / 10</span>
          <div class="boss-dots" id="bossDots" aria-label="Bossfortschritt"></div>
        </div>
      </section>

      <section class="field enemy-field enemy-stage">
        <div class="enemy-board">
          <div class="wood-banner" id="enemyCrewTitle">☠ PIRAT KAI · CREW</div>
          <div class="lanes" id="enemyLanes"><div class="slot">FREI</div><div class="slot">FREI</div><div class="slot">FREI</div></div>
        </div>
        <div class="boss-side-visual" aria-label="Aktiver Piratenboss">
          <div class="boss-aura"></div>
          <img class="boss-img" id="bossSprite" src={kai} alt="Pirat Kai" />
        </div>
      </section>

      <section class="player-stage">
        <div class="tula-visual"><div class="tula-aura"></div><img id="tulaSprite" src={tula} alt="Tula" /></div>
        <div class="player-field">
          <div class="blue-banner">DEIN PLATZ</div>
          <div class="lanes" id="playerLanes"><div class="slot">DEIN PLATZ</div><div class="slot">DEIN PLATZ</div><div class="slot">DEIN PLATZ</div></div>
          <div class="energy-line"><span>WELLENKRAFT</span><div class="energy" id="energy"></div></div>
        </div>
      </section>
    </main>

    <div class="info-toast is-minimized" id="infoToast" aria-label="Spielhinweis">
      <button class="info-toast-mini" id="infoToastMini" type="button" aria-label="Letzten Spielhinweis öffnen" title="Spielhinweis öffnen">
        <span class="mini-icon">i</span>
        <span class="mini-dot" aria-hidden="true"></span>
      </button>
      <div class="info-toast-panel" id="infoToastPanel" role="status" aria-live="polite">
        <span class="info-badge" aria-hidden="true">i</span>
        <div class="info-toast-copy">
          <small>SPIELHINWEIS</small>
          <b id="log">Spiele eine Karte. Richtige Übersetzungen machen sie stärker.</b>
        </div>
        <button class="info-toast-close" id="infoToastClose" type="button" aria-label="Spielhinweis minimieren" title="Minimieren">−</button>
      </div>
    </div>

    <section class="hand">
      <div class="hand-title"><small>DEINE HAND</small><small>ANTIPPEN → FRAGE LÖSEN</small></div>
      <div class="cards" id="cards"></div>
      <div class="footer-actions"><button class="end" id="endTurn">⚔ ZUG BEENDEN</button></div>
    </section>

    <details class="boss-roster-section">
      <summary>☠ FREIBEUTER-ROUTE · 10 BOSSE</summary>
      <p class="boss-roster-hint">Boss zum Testen direkt antippen. Dieser Bereich wird zum Spielen nicht benötigt.</p>
      <div class="boss-roster" id="bossRoster"></div>
    </details>
  </div>

  <div class="learn" id="learn" aria-modal="true" role="dialog">
    <div class="sheet">
      <small>KARTEN-MEISTERSCHAFT · DE → EN</small>
      <h2 id="questionTitle">Was bedeutet …?</h2>
      <p id="questionCopy"></p>
      <div class="answers" id="answers"></div>
      <div class="mastery" id="mastery">Richtig = Karte darf ins Spiel. Falsch = Karte geht für diesen Bosskampf verloren.</div>
    </div>
  </div>

  <div class="overlay" id="intro">
    <div class="intro">
      <div class="intro-plaque"><span>☸</span><strong>PIRATE DECK</strong><small>TULA’S ISLAND</small></div>
      <div class="intro-hero"><img src={tula} alt="Tula" /><img id="introBossSprite" src={kai} alt="Pirat Kai" /></div>
      <span class="boss-ribbon intro-ribbon">☠ BOSS 1 / 10</span>
      <h2 id="introBossTitle">Pirat Kai wartet.</h2>
      <p>Beschwöre deine Monster-Crew, löse unabhängige Sprachfragen und besiege die Piratenbosse.</p>
      <button id="start">⚔ DUELL STARTEN</button>
      <span class="note">Deutsch → Englisch · Mobile Battle</span>
    </div>
  </div>

  <div class="guide-overlay" id="gameGuide" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="guideTitle">
    <div class="guide-card">
      <div class="guide-kicker">⚓ SPIELANLEITUNG</div>
      <h2 id="guideTitle">So funktioniert Pirate Deck</h2>
      <p class="guide-lead">Deine Monsterkarten und die Sprachfragen sind getrennt: Du wählst zuerst dein Monster, dann entscheidet eine Sprachfrage, ob es ins Spiel darf.</p>
      <div class="guide-grid">
        <section class="guide-step">
          <div class="guide-step-head"><span class="guide-icon">🃏</span><strong>1. Monster wählen</strong></div>
          <p>Tippe unten eine Monsterkarte an. Die türkise Anzeige wie <span class="guide-cost-demo">🌊 2</span> zeigt, wie viel <b>Wellenkraft</b> sie kostet.</p>
        </section>
        <section class="guide-step">
          <div class="guide-step-head"><span class="guide-icon">💬</span><strong>2. Frage lösen</strong></div>
          <p>Die Frage ist <b>unabhängig vom Monster</b>. Richtig: Die Karte darf ins Spiel. Falsch: Die Karte und ihre Wellenkraft sind für diesen Bosskampf verloren.</p>
        </section>
        <section class="guide-step">
          <div class="guide-step-head"><span class="guide-icon">🌊</span><strong>3. Wellenkraft</strong></div>
          <p>Du startest mit <b>3 / 3 Wellenkraft</b>. Jede Karte verbraucht ihren angezeigten Wert. Nach „Zug beenden“ wird sie aufgefüllt und dein Maximum steigt schrittweise.</p>
        </section>
        <section class="guide-step">
          <div class="guide-step-head"><span class="guide-icon">⚔</span><strong>4. Kampfwerte</strong></div>
          <p><b>⚔ Angriff</b> bestimmt deinen Schaden. <b>🛡 Verteidigung</b> zeigt, wie robust dein Monster ist. Beim Zugende greift deine Crew den Boss an.</p>
        </section>
      </div>
      <div class="guide-warning">🎯 Ziel: Boss-Leben auf 0 bringen, bevor Tulas 20 Leben aufgebraucht sind. Fehler kosten echte Karten – also lieber genau hinschauen.</div>
      <div class="guide-actions">
        <label class="guide-skip"><input type="checkbox" id="guideSkip" /> Anleitung künftig überspringen</label>
        <button class="guide-start" id="guideStart" type="button">⚔ VERSTANDEN · DUELL STARTEN</button>
      </div>
    </div>
  </div>

  <script src={`${base}pirate-deck.js`} defer></script>
  <script src={`${base}pirate-deck-card-rules-v2.js`} defer></script>
  <script src={`${base}pirate-deck-monster-cards-v1.js`} defer></script>
  <script src={`${base}pirate-deck-ui-runtime-v18.js`} defer></script>
</body>
</html>
